  "dead": {
    "kept_min_per_game": 0.1,
    "played_per_kept_max": 0.25,
    "played_max_per_game": 0.1,
    "spent_per_gained_min": 0.5
  },
  "usage": {
    "note": "207: each player action's expected use, a band by role (candidates for Matt). Pooled over levels and boards, over the seat-games that could take it (a power: its board's seats). Measures: seat_round (uses a seat-round; a once-a-round action's share of rounds), seat_game (uses a seat-game), games (share of seat-games with a use), spent (a resource's spent over gained). A row's band overrides its role's; 'off' (a baseline param, or true) lists it as off. `design_check.py READ --usage` prints the inventory.",
    "roles": {
      "node-power": {"measure": "seat_round", "band": [0.3, 0.9], "why": "the board's node route, once a round: most rounds, never every round (a node is always right then)"},
      "board-engine": {"measure": "seat_round", "band": [0.4, 0.9], "why": "the board's signature 'each round you may' power: most rounds, not all"},
      "sacrifice": {"measure": "seat_game", "band": [0.25, 2.0], "why": "a tag-sacrifice power for cards you are done with: a use every game or two, never a round staple"},
      "troop-response": {"measure": "seat_game", "band": [0.25, 2.5], "why": "answers troops when they come: used in most games that have them, not a round staple"},
      "hedge": {"measure": "seat_game", "band": [0.05, 0.5], "why": "a luck hedge or desperate source, poorly priced by design: rare but not zero"},
      "win-route": {"measure": "games", "band": [0.5, 0.95], "why": "a Unity route the win runs through: most games, not every game (another route must exist)"},
      "sway-tool": {"measure": "seat_game", "band": [0.1, 2.0], "why": "a secondary Unity or Discord lever: used, never the route"},
      "staple": {"measure": "seat_round", "band": [0.1, 1.2], "why": "a standard economy action: used in some rounds, never crowding the round"},
      "cards": {"measure": "seat_round", "band": [1.0, 4.0], "why": "cards are the game: plays most of a round's actions"},
      "building": {"measure": "seat_round", "band": [0.2, 1.5], "why": "a building's once-a-round Action: the engine running"},
      "converter": {"measure": "seat_game", "band": [0.3, 3.0], "why": "a completed megaproject's once-a-round converter: used once it opens, not every round from the start"},
      "threat": {"measure": "seat_game", "band": [0.5, 5.0], "why": "paying a threat's counter: threats are answered, not ignored, and not the whole game"},
      "correction": {"measure": "seat_game", "band": [0.0, 0.5], "why": "taking back a commitment: zero is fine, often means misplays"},
      "resource": {"measure": "spent", "band": [0.5, 1.1], "why": "a resource gained is spent (engines over dials); over 1.1 is a start stock spent down"},
      "off": {"why": "off at this revision's tunables or granted by no card: listed, no band"}
    },
