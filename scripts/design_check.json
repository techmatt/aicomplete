      {"key": "standard:botnet", "name": "Take down a botnet", "role": "sway-tool"},
      {"key": "standard:clear", "name": "Clear a corruption marker", "role": "off", "off": "board.clear_cost"},
      {"key": "standard:harden_buy", "name": "Project: harden", "role": "off", "off": "board.harden_credits"},
      {"key": "standard:drain", "name": "Project: drain", "role": "off", "off": "board.drain_credits"},
      {"key": "standard:factory", "name": "Build a factory", "role": "off", "off": "board.factory_build_chips"},
      {"key": "standard:harden_chips", "name": "Harden for chips", "role": "off", "off": true},
      {"key": "play", "name": "Play a card", "role": "cards"},
      {"key": "use", "name": "A building's Action", "role": "building"},
      {"key": "convert:Tidal Grid", "name": "Tidal Grid converter", "role": "converter"},
      {"key": "convert:Tidal Grid:chips", "name": "Tidal Grid chip converter", "role": "converter"},
      {"key": "convert:Polar Compute Array", "name": "Polar Compute Array converter", "role": "converter"},
      {"key": "convert:Polar Compute Array:chips", "name": "Polar Compute Array chip converter", "role": "converter"},
      {"key": "pay", "name": "Pay a threat's counter", "role": "threat"},
      {"key": "counter_with", "name": "Counter a threat whole", "role": "hedge", "why": "the counter that asks more than resources"},
      {"key": "withdraw", "name": "Withdraw from a threat", "role": "correction"},
      {"key": "spend:credits", "name": "Credits spent", "role": "resource"},
      {"key": "spend:energy", "name": "Energy spent", "role": "resource"},
      {"key": "spend:chips", "name": "Chips spent", "role": "resource"},
      {"key": "spend:antimatter", "name": "Antimatter spent", "role": "resource"},
      {"key": "spend:research_cubes", "name": "Research cubes spent", "role": "resource"},
      {"key": "spend:ambassadors", "name": "Ambassadors spent", "role": "resource"}
