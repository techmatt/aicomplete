      {"key": "standard:remove", "name": "Remove agents", "role": "staple"},
      {"key": "standard:station", "name": "Build a research station", "role": "staple"},
      {"key": "standard:antimatter", "name": "Make antimatter", "role": "hedge", "why": "the desperate antimatter source (204)"},
      {"key": "standard:troop", "name": "Remove a troop", "role": "hedge", "why": "the troop hedge (206)"},
      {"key": "standard:ambassador", "name": "Gain a player ambassador", "role": "hedge", "why": "20 credits: the ambassador hedge"},
      {"key": "sell", "name": "Sell a card", "role": "hedge", "why": "a dead hand's 1 credit"},
      {"key": "standard:liberate", "name": "Liberate a site", "role": "win-route"},
      {"key": "standard:breakthrough", "name": "Breakthrough", "role": "win-route", "why": "the standard antimatter spend, Unity (204)"},
      {"key": "standard:claim", "name": "Claim a site", "role": "sway-tool"},
