      {"key": "power:researcher:Disrupt", "role": "troop-response"},
      {"key": "standard:node", "name": "Place a node", "role": "staple"},
      {"key": "standard:move", "name": "Dispatch", "role": "staple"},
      {"key": "standard:buy_energy", "name": "Buy a city's energy", "role": "staple"},
