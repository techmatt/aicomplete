# 157 (r68, Matt 2026-11-09): no tier III frees or clears a city outright. A tier III gives one player a lot of
# ambassadors, or removes a decent number (6) of adversary ambassadors around one corrupted city in reach; the players
# still reach the city and Liberate it. Rerun: python scripts/cards/apply_overlay.py experiments/results/157_strategist_purge_r68/tier3.overlay
# The four that liberated a city.
alignment.volunteer_corps.tiers.2={"text": "One player gains 8 ambassadors.", "effects": [{"op": "one_player", "then": [{"op": "gain_ambassadors", "count": 8}]}]}
alignment.popular_mandate.tiers.2={"text": "One player gains 6 ambassadors and moves up to 3 of their ambassadors onto pieces in their reach.", "effects": [{"op": "one_player", "then": [{"op": "gain_ambassadors", "count": 6}, {"op": "move_ambassadors", "max": 3}]}]}
alignment.reclamation.tiers.2={"text": "One player takes the adversary cube off up to 2 corrupted research stations or factories in their reach, then removes up to 6 adversary ambassadors on or next to one corrupted city in their reach.", "effects": [{"op": "one_player", "then": [{"op": "cleanse", "amount": 2, "one_country": false}, {"op": "clear_city", "max": 6}]}]}
alignment.citizens_assembly.tiers.2={"text": "Sway 3 toward Unity; one player gains 6 ambassadors.", "effects": [{"op": "sway", "side": "unity", "amount": 3}, {"op": "one_player", "then": [{"op": "gain_ambassadors", "count": 6}]}]}
# The six that removed every adversary ambassador around a corrupted city: up to 6 now.
alignment.think_tank.tiers.2={"text": "Every player gains 1 insight each round for the rest of the game; one player removes up to 6 adversary ambassadors on or next to one corrupted city in their reach, then gains 2 ambassadors.", "effects": [{"op": "team_income", "resource": "insight", "amount": 1}, {"op": "one_player", "then": [{"op": "clear_city", "max": 6}, {"op": "gain_ambassadors", "count": 2}]}]}
alignment.ceasefire.tiers.2={"text": "Counter every active threat; one player removes up to 6 adversary ambassadors on or next to one corrupted city in their reach.", "effects": [{"op": "counter_all"}, {"op": "one_player", "then": [{"op": "clear_city", "max": 6}]}]}
alignment.town_hall_accord.tiers.2={"text": "One player removes up to 6 adversary ambassadors on or next to one corrupted city in their reach, then gains 2 ambassadors.", "effects": [{"op": "one_player", "then": [{"op": "clear_city", "max": 6}, {"op": "gain_ambassadors", "count": 2}]}]}
alignment.mutual_aid.tiers.2={"text": "Every player gains 2 energy; one player removes up to 6 adversary ambassadors on or next to one corrupted city in their reach.", "effects": [{"op": "gain", "resource": "energy", "amount": 2}, {"op": "one_player", "then": [{"op": "clear_city", "max": 6}]}]}
alignment.disarmament_talks.tiers.2={"text": "One player removes 4 adversary ambassadors or 4 troops in one hex in their reach, then up to 6 adversary ambassadors on or next to one corrupted city in their reach.", "effects": [{"op": "one_player", "then": [{"op": "damage", "ambassadors": 4, "troops": 4}, {"op": "clear_city", "max": 6}]}]}
alignment.network_cleanup.tiers.2={"text": "One player removes a botnet in their reach, clears up to 2 corruption markers in their reach, then removes up to 6 adversary ambassadors on or next to one corrupted city in their reach.", "effects": [{"op": "one_player", "then": [{"op": "remove_botnet"}, {"op": "clear_markers", "count": 2}, {"op": "clear_city", "max": 6}]}]}
