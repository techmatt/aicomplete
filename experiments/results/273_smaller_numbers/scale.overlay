corps.horizon.project={"name":"Tidal Grid","cubes":8,"text":"At completion each player cube pays 3 energy and 2 credits, each adversary cube 1 Sway to Discord. Afterward, once a round, with a city here in your reach: 3 research cubes for 5 energy; and, once a round, 2 chips for 3 energy. Afterward an adversary station here puts its cubes onto the adversary's research track.","player":[{"op":"gain","resource":"energy","amount":3},{"op":"gain","resource":"credits","amount":2}],"adversary":[{"op":"sway","side":"discord","amount":1,"narrative":"fear"}],"converter":{"cost":[["research_cubes",3]],"effects":[{"op":"gain","resource":"energy","amount":5}],"once":true},"chip_converter":{"cost":[["chips",2]],"effects":[{"op":"gain","resource":"energy","amount":3}],"once":true}}
corps.cintamani.project={"name":"Polar Compute Array","cubes":8,"text":"At completion each player cube pays 6 credits, each adversary cube 1 adversary compute. Afterward, once a round, with a city here in your reach: 1 research cube for 2 insight; and, once a round, 1 chip for 1 drawn card and 1 credit. Afterward an adversary station here puts its cubes onto the adversary's research track.","player":[{"op":"gain","resource":"credits","amount":6}],"adversary":[{"op":"compute","amount":1}],"converter":{"cost":[["research_cubes",1]],"effects":[{"op":"gain","resource":"insight","amount":2}],"once":true},"chip_converter":{"cost":[["chips",1]],"effects":[{"op":"draw","count":1},{"op":"gain","resource":"credits","amount":1}],"once":true}}
corps.onyx.project={"name":"Mountain Fusion Works","cubes":8,"text":"At completion each player cube pays 2 chips and 2 credits, each adversary cube 1 Sway to Discord. Afterward, once a round, with a city here in your reach: 1 research cube for 1 chip. Afterward an adversary station here puts its cubes onto the adversary's research track.","player":[{"op":"gain","resource":"chips","amount":2},{"op":"gain","resource":"credits","amount":2}],"adversary":[{"op":"sway","side":"discord","amount":1,"narrative":"fear"}],"converter":{"cost":[["research_cubes",1]],"effects":[{"op":"gain","resource":"chips","amount":1}],"once":true}}
corps.biomia.project={"name":"Delta Seawall","cubes":8,"text":"At completion each player cube pays 1 Sway to Unity and 3 credits, each adversary cube 1 Sway to Discord. Afterward, once a round, with a city here in your reach: 1 research cube for 1 Sway to Unity; and, once a round, 2 chips for 2 Sway to Unity and 1 drawn card. Afterward an adversary station here puts its cubes onto the adversary's research track.","player":[{"op":"sway","side":"unity","amount":1,"narrative":"cooperation"},{"op":"gain","resource":"credits","amount":3}],"adversary":[{"op":"sway","side":"discord","amount":1,"narrative":"fear"}],"converter":{"cost":[["research_cubes",1]],"effects":[{"op":"sway","side":"unity","amount":1,"narrative":"cooperation"}],"once":true},"chip_converter":{"cost":[["chips",2]],"effects":[{"op":"sway","side":"unity","amount":2,"narrative":"cooperation"},{"op":"draw","count":1}],"once":true}}
