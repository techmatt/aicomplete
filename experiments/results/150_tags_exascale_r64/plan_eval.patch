+
+/// 150 (`plan_eval`): whether the play eval `ev` reads seat `s` playing `id`
+/// now as a gain over holding it: on a copy of the table in the play phase,
+/// with the card in hand and its costs added to what the seat holds, the
+/// eval's value after the play against before it. A play the rules refuse
+/// there (a requirement, a target) is the plan's own call, so it counts as a yes.
+fn eval_plays(rules: &Rules, ev: &super::eval::Eval, g: &GameState, s: usize, id: &Key) -> bool {
+    eval_play_gain(rules, ev, g, s, id).is_none_or(|x| x > 0.0)
+}
+
+fn eval_play_gain(rules: &Rules, ev: &super::eval::Eval, g: &GameState, s: usize, id: &Key) -> Option<f64> {
+    let w = rules.world();
+    let phase = g.config.round.iter().position(|p| p.starts_with("cards.play"))?;
+    let d = cards::def(&w, id);
+    let mut h = g.clone();
+    h.pending = None;
+    h.phase = phase;
+    h.seats[s].passed = false;
+    for pile in [cards::drafted(s), cards::packet(s)] {
+        let rest: Vec<Key> = h.pile(&pile).iter().filter(|k| *k != id).cloned().collect();
+        h.piles.insert(pile.into(), Arc::new(rest));
+    }
+    let mut hand = h.pile(&cards::hand(s)).to_vec();
+    hand.retain(|k| k != id);
+    hand.push(*id);
+    h.piles.insert(cards::hand(s).into(), Arc::new(hand));
+    let costs = [
+        (Resource::Credits, cards::play_cost(&w, g, s, d)),
+        (Resource::Insight, cards::play_insight(&w, g, s, d)),
+        (Resource::Chips, d.chips),
+        (Resource::Energy, d.energy),
+        (Resource::Antimatter, d.antimatter),
+        (Resource::ResearchCubes, d.research_cubes),
+    ];
+    for (r, n) in costs {
+        let have = h.resource(s, r).max(0);
+        h.seats[s].resources.insert(r, have + n.max(0));
+    }
+    let before = ev.value(rules, &h);
+    let play = Action::Play { seat: s as u8, card: *id };
+    let (after, _) = rules.apply(&h, &play).ok()?;
+    Some(ev.value(rules, &after) - before + ev.bonus(&w, &play))
 }
 
