+/// 131 measure (not committed): a resolved threat's outcome by its source and
+/// whether an auto-counter of its type stood for it then.
+fn m131_outcome(g: &mut GameState, cx: &mut Cx, threat: &str, outcome: &str) {
+    let w = cx.world;
+    let held = if standing(&w, g, threat) > 0 { "held" } else { "open" };
+    let src = format!("{:?}", source_of(&w, threat)).to_lowercase();
+    cx.tally(g, &format!("m131.out.{src}.{outcome}.{held}"), 1);
+}
+
+/// 131 measure: what one execution did, as counter and holding changes.
+fn m131_snapshot(g: &GameState) -> (Vec<(String, i64)>, Vec<[i64; 7]>, Vec<i64>) {
+    let counters = g.stats.counters.iter().map(|(k, v)| (k.as_str().to_string(), *v)).collect();
+    let all = [
+        Resource::Ambassadors,
+        Resource::Antimatter,
+        Resource::Chips,
+        Resource::Credits,
+        Resource::Energy,
+        Resource::Insight,
+        Resource::ResearchCubes,
+    ];
+    let res = (0..g.seats.len()).map(|s| std::array::from_fn(|i| g.resource(s, all[i]))).collect();
+    let nodes = (0..g.seats.len()).map(|s| node_count(g, s)).collect();
+    (counters, res, nodes)
+}
+
+fn m131_harm(g: &mut GameState, cx: &mut Cx, src: &str, held: &str, before: (Vec<(String, i64)>, Vec<[i64; 7]>, Vec<i64>)) {
+    let (after_c, after_r, after_n) = m131_snapshot(g);
+    let was: std::collections::BTreeMap<String, i64> = before.0.into_iter().collect();
+    for (k, v) in after_c {
+        if k.starts_with("m131.") {
+            continue;
+        }
+        let d = v - was.get(&k).copied().unwrap_or(0);
+        if d != 0 {
+            cx.tally(g, &format!("m131.exec.{src}.{held}.c.{k}"), d);
+        }
+    }
+    let names = ["ambassadors", "antimatter", "chips", "credits", "energy", "insight", "research_cubes"];
+    for s in 0..after_r.len() {
+        for i in 0..7 {
+            let lost = before.1[s][i] - after_r[s][i];
+            if lost != 0 {
+                cx.tally(g, &format!("m131.exec.{src}.{held}.lost.{}", names[i]), lost);
+            }
+        }
+        let nl = before.2[s] - after_n[s];
+        if nl != 0 {
+            cx.tally(g, &format!("m131.exec.{src}.{held}.lost.nodes"), nl);
+        }
+    }
+}
