+/// 169: the agents a gathering Corrupt line pulls into site `h`, as the rule does: from neighbors in its own country,
+/// none onto a firewalled site.
+fn pulled_into(w: &World, g: &GameState, h: usize) -> i64 {
+    if common::firewalled(g, h) {
+        return 0;
+    }
+    let c = w.map.hexes[h].country;
+    w.map.hexes[h].neighbors.iter().filter(|&&x| w.map.hexes[x].country == c).map(|&x| agents(g, x)).sum()
+}
