+/// 278: the round the hosts were fixed in (`board.host_fixed`), and each city's fixed host (seat + 1; 0 none).
+pub const HOST_FIXED_ROUND: &str = "board.host_fix.round";
+pub fn host_fixed_key(h: usize) -> String {
+    format!("board.host_fix.{h}")
+}
