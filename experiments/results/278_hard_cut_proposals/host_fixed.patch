+/// A neutral city producing now: no cube, no agent on it, no blackout.
+fn host_open(w: &World, g: &GameState, h: usize) -> bool {
+    clean_city(w, g, h)
+        && g.tokens(h, ADV_AMBASSADOR) == 0
+        && !super::board::hex_flagged(w, g, crate::content::RoundFlag::Blackout, h)
+}
